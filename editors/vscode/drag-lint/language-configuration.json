{
  "comments": {
    "lineComment": "//",
    "blockComment": ["{", "}"]
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"], ["begin", "end"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "(*", "close": "*)" }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["'", "'"]],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
