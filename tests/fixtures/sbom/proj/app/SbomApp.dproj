  <PropertyGroup>
    <MainSource>SbomApp.dpr</MainSource>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="AppMain.pas"/>
