# SaveToFile/LoadFromFile/TFile.WriteAllText/ReadAllText/TStreamReader.Create
# without an explicit TEncoding argument fire; the same calls with a trailing
# TEncoding.UTF8 argument are clean.
default-encoding-io 15
!default-encoding-io 27
default-encoding-io 39
default-encoding-io 47
!default-encoding-io 52
default-encoding-io 59
default-encoding-io 66
!default-encoding-io 78
# v0.81 review Minor: a filename literal containing the text "TEncoding" must
# NOT suppress the finding -- string literals can never themselves be a
# TEncoding argument.
default-encoding-io 92
