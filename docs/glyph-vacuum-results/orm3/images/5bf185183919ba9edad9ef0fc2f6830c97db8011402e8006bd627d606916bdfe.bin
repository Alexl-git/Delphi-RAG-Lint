"SELECT Statement"
,,,,,,,
SELECT	Ii."CharID" , Os."OperID" , Ii."PlanID" , 
	PL."ProcDyn" , PL."PType" , Gi."InspType" , 
	ir."ID" , ir."OSublotID"
FROM	"PLANLIST.DB" PL , "msclist.DB" ms , 
	"Ginsp.DB" Gi , "Insprslt.DB" ir , 
	"Osublot.DB" Os , "Iinsp.db" Ii
WHERE	( Ii.GID = Gi.ID )
		AND
	( Ii.PlanID = PL.ID )
		AND
	( Ii.CharID = ms.ID )
		AND
	( Ii.ID = ir.InspID )
		AND
	( ir.OSublotID = Os.ID )
		AND
	(
	( ( Ii."CharID" = :ChrID ) AND
		( Os."OperID" = :OprID ) AND
		( Gi."InspType" = :inType ) AND
		( ir,,,,,,,
."OSublotID" = :RsltOSublotID ) )
	),,,,,,,
