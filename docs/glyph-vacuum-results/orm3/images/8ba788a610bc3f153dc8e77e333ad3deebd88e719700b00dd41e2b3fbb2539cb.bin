"SELECT Statement"
,,,,,,,
SELECT	ms."ID" , IA."Order" , IA."Name" , 
	PL."PName" , PL."PDescription"
FROM	"Ginsp.DB" GI , "Iinsp.db" II , 
	"msclist.DB" ms , "InspName.DB" IA , 
	"PLANLIST.DB" PL
WHERE	( II.GID = GI.ID )
		AND
	( II.PlanID = PL.ID )
		AND
	( ms.ID = II.CharID )
		AND
	( GI.InspType = IA.ID )
		AND
	(
	( ms."ID" = :ID )
	)
ORDER BY
	IA."Order",,,,,,,
