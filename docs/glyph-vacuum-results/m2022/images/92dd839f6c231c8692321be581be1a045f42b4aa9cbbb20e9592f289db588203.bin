"SELECT Statement"
,,,,,,,
SELECT	onf."OperID" , onf."OsublotID" , onf."On" , 
	onf."Off" , onf."Reason" , onf."PcsProd" , 
	onf."PcsProdCor" , onf."ONOff" , 
	onf."MasterID" , onf."OptorID" , 
	onf."Scrap" , onf."Rework" , 
	onf."SortOut" , onf."PcsSec"
