"SELECT Statement"
,,,,,,,
SELECT	TA."FldrID" , TA."OperID" , TA."ToolID" , 
	TA."Position" , TA."OProcessSet" , 
	TA."TProcessSet" , TA."OSublotID" , 
	TA."ONN" , TA."OFF" , TA."ReaStop" , 
	TA."ToolWear" , TA."SurfFinish" , 
	TA."ChipForm" , TA."CausFail" , 
	TA."CorrAct" , TA."Notes" , 
	TA."FOReastop" , TA."FOToolWear" , 
	TA."FOSurfFinish" , TA."FOChipForm" , 
	TA."FOCausFail" , TA."FOCorrAct" , 
	TA."FOReastopMemo" , 
	TA."FOToolWearMemo" , 
	TA."FOSurfFinishMemo" , 
	TA."FOChipFormMemo" , 
	TA."FOCauseFailMemo" ,,,,,,,
, 
	TA."FOCorrActMemo" , TA."AdjTime" , 
	TA."AdjUnits" , TA."AdjPcs" , 
	TA."SharpTime" , TA."SharpUnits" , 
	TA."SharpPcs" , TA."ChangeTime" , 
	TA."ChangeUnits" , TA."ChangePcs" , 
	TA."IndexTime" , TA."IndexUnits" , 
	TA."IndexPcs" , TA."NewTime" , 
	TA."NewUnits" , TA."NewPcs" , 
	TA."NewTool" , TA."UseIt"
FROM	"ToolAdj.DB" TA
WHERE	( ( TA."FldrID" = :FldrID ) AND
		( TA."OperID" = :OperID ) AND
		( TA."ToolID" = :ToolID ) AND
		( TA."Position" = :Position ) AND
		( TA."OProcessSet" = :,,,,,,,
OprocessSet ) AND
		( TA."TProcessSet" = :TProcessSet ) )
ORDER BY
	TA."ONN",,,,,,,
