ToolID,ToolAssg,ID,T2,          ,          ,,

"SELECT Statement"
,,,,,,,
SELECT	 DISTINCT ToolAssg."OperID" , ToolAssg."FldrID" , 
	T2."Tag1" , T2."Tag2" , T2."Tag3" , 
	ToolAssg."Application" , T2."ID"
FROM	"ToolGR12.DB" T2 , "ToolAssg.DB" ToolAssg
WHERE	( ToolAssg."ToolID" = T2."ID" )
		AND
	(
	( ( ToolAssg."OperID" = :ID ) AND
		( ToolAssg."FldrID" = :FldrID ) AND
		( T2."Tag3" = 'GROUP' ) AND
		( ToolAssg."Application" = 4 ) )
	),,,,,,,
