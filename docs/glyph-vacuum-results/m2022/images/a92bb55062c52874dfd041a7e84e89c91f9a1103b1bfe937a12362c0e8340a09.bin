"SELECT Statement"
,,,,,,,
SELECT	II."CharID" , GI."InspType" , 
	IR."OSublotID" , IP."SampleNum" , 
	IP."Filled" , IP."SampleSize" , 
	IP."RsltID" , IP."ProcessNum" , 
	IP."SinProcNum" , IP."SetupMode" , 
	IP."SetupDone" , IP."ActiveSample" , 
	IP."OnTime" , IP."OffTime" , IP."Time1" , 
	IP."PcsProd" , IP."PcsProdCorr" , 
	IP."Min" , IP."Max" , IP."USL" , IP."LSL" , 
	IP."UCL" , IP."LCL" , IP."Average" , 
	IP."Status" , IP."Action" , IP."M1" , 
	IP."M2" , IP."M3" , IP."M4" , IP."Sigma" , 
	IP."Cp" , IP."Cpk" , IP."Zdu" ,,,,,,,
, IP."Zdl" , 
	IP."Zdi" , IP."R1" , IP."R2" , IP."R3" , 
	IP."R4" , IP."R5" , IP."R6" , IP."R7" , IP."R8" , 
	IP."R9" , IP."R10" , IP."R11" , IP."R12" , 
	IP."R13" , IP."YU" , IP."YL" , IP."RU" , 
	IP."RL" , IP."Zdi2" , IP."Zdu2" , IP."Zdl2" , 
	IP."Ppk3" , IP."Cpkp" , IP."Cpp" , 
	IP."Sigma2" , IP."Sigma3" , IP."SigmaP" , 
	IP."InspTime" , IP."ToolTime" , 
	IP."DriftM" , IP."VariationM" , 
	IP."AverageP" , IP."Cprd2" , IP."Cpkrd2" , 
	IP."CpSamp" , IP."CpkSamp" , 
	IP."CpSampRd2" , IP."CpkSamp,,,,,,,
Rd2" , 
	IP."OptrID" , IP."Notes"
FROM	"Iinsp.db" II , "Ginsp.DB" GI , 
	"Insprslt.DB" IR , "Ipchart.DB" IP
WHERE	( II.GID = GI.ID )
		AND
	( IR.InspID = II.ID )
		AND
	( IP.RsltID = IR.ID )
		AND
	(
	( ( II."CharID" = :ID ) AND
		( GI."InspType" = 9 ) AND
		( IP."Filled" = True ) AND
		( IP."SampleSize" >0 ) )
	)
ORDER BY
	IR."OSublotID" , IP."SampleNum",,,,,,,
