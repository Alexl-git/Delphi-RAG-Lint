"SELECT Statement"
,,,,,,,
SELECT	Os."ID" , Os."OperID" , Os."Size" , 
	Os."OpenTime"
FROM	"Osublot.DB" Os , "Insprslt.DB" Ir
WHERE	( Ir.OSublotID = Os.ID )
		AND
	(
	( Os."OperID" = :ID )
	)
ORDER BY
	Os."OperID" , Os."OpenTime",,,,,,,
