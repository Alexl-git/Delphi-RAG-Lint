"SELECT Statement"
,,,,,,,
SELECT	TA."FldrID" , TA."OperID" , TA."Position" , 
	TA."ToolID" , TA."Tool" , TA."ONN" , 
	EP."ToolChange" , TA."OFF" , 
	TA."OProcessSet" , TA."TProcessSet" , 
	TA."Reason" , EP."Reason" , 
	Op."MachineGr" , TA."ID"
FROM	"EndProc.DB" EP , "ToolAdj.DB" TA , 
	"Operat.DB" Op
WHERE	( TA."Reason" = EP."ID" )
		AND
	( TA."OperID" = Op."ID" )
		AND
	(
	( ( TA."FldrID" = :FldrID ) AND
		( TA."OperID" = :OperID ) AND
		( TA."Position" = :Position ) AND
		( TA."ToolID" = :ToolID ) AND
		( TA."ONN,,,,,,,
" <:ONN ) AND
		( TA."OFF" <:OFF ) )
	)
ORDER BY
	TA."ONN",,,,,,,
