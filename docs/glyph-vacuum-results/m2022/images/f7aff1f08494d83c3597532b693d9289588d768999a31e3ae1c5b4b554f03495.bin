"SELECT Statement"
,,,,,,,
SELECT	ms."FldrID" , ms."ID" , ms."MasterID" , 
	ms."OperID" , ms."Num" , ms."FtrType" , 
	ms."FtrClass" , ms."FtrMClass" , 
	ms."FtrQClass" , ms."AttrType" , 
	ms."AttrCode" , ms."AttrName" , 
	ms."DimName" , ms."DimAbbr" , 
	ms."FtrSuffix" , ms."DimUnits" , 
	ms."Decimals" , ms."SpecType" , 
	ms."Notation" , ms."Nominal" , 
	ms."UpperTol" , ms."LowerTol" , 
	ms."OriginalUSL" , ms."OriginalLSL" , 
	ms."USL" , ms."LSL" , ms."InspAsVar" , 
	ms."GagePortNmbr" , ms."Notes" , 
	ms."MainInsp"
FROM,,,,,,,
	"Iinsp.db" Ii , "msclist.DB" ms
WHERE	( Ii.CharID = ms.ID )
		AND
	(
	( ( Ii."GID" = :GID ) AND
		( ms."FtrType" = 1 ) )
	)
ORDER BY
	ms."Num",,,,,,,
