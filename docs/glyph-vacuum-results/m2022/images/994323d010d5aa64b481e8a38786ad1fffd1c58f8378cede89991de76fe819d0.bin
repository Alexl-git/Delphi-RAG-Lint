"SELECT Statement"
,,,,,,,
SELECT	 DISTINCT TA."PosID" , TA."ToolGroup" , 
	TA."PosNameStr" , TA."ToolID" , 
	TA."Application"
FROM	"ToolAssg.DB" TA
WHERE	( ( TA."FldrID" = :FldrID ) AND
		( TA."FtrID" = :ID ) AND
		( TA."Application" <4 ) )
ORDER BY
	TA."ToolGroup" , TA."PosNameStr",,,,,,,
