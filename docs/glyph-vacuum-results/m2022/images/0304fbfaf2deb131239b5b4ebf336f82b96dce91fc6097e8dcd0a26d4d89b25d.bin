Fldr_SystID,Fo,FldrID,Jo,          ,          ,,

"SELECT Statement"
,,,,,,,
SELECT	Fo."NextEvent" , Fo."PartNmbr" , 
	Fo."WrkOrdrNmbr" , Jo."Station"
FROM	"Folders.DB" Fo , "JobStn.DB" Jo
WHERE	( Fo.Fldr_SystID = Jo.FldrID )
		AND
	(
	( ( Fo."RTState" = 1 ) AND
		( Jo."Station" = '1' ) )
	)
ORDER BY
	Fo."NextEvent",,,,,,,
