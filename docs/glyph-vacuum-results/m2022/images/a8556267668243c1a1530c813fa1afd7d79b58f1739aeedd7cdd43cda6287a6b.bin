PlanID,Ii,ID,PL,          ,          ,,

"SELECT Statement"
,,,,,,,
SELECT	 DISTINCT Ii."CharID" , 
	( count( Ii.PlanID ) )  as pnum , 
	PL."ForVariable" , Ii."PlanID"
FROM	"PLANLIST.DB" PL , "Iinsp.db" Ii
WHERE	( Ii."PlanID" = PL."ID" )
		AND
	(
	( ( Ii."CharID" = :ID ) AND
		( PL."ForVariable" = True ) )
	)
GROUP BY
	Ii."PlanID" , Ii."CharID" , PL."ForVariable",,,,,,,
