ToolID,TA,ID,T12,          ,          ,,

"SELECT Statement"
,,,,,,,
SELECT	 DISTINCT TA."FldrID" , TA."OperID" , T12."Tag2" , 
	T12."Tag1" , T12."Tag3" , TA."ToolID" , 
	TA."PosID" , TA."Application"
FROM	"ToolAssg.DB" TA , "ToolGR12.db" T12
WHERE	( TA."ToolID" = T12."ID" )
		AND
	(
	( ( TA."FldrID" = :FID ) AND
		( TA."OperID" = :ID ) )
	),,,,,,,
