"SELECT Statement"
,,,,,,,
SELECT	 DISTINCT TG."Tag1" , TG."Tag2" , TG."Tag3" , TG."ID"
FROM	"ToolGR12.DB" TG , "Folders.DB" Fo , 
	"ToolFldr.DB" TF
WHERE	( Fo."Fldr_SystID" = TF."FldrID" )
		AND
	( TF."ToolID" = TG."ID" )
		AND
	(
	( Fo."WrkOrdrNmbr" = :WrkOrdrNmbr )
	)
ORDER BY
	TG."Tag1" , TG."Tag2" , TG."Tag3",,,,,,,
