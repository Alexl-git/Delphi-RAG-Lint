FldrID,TA,FldrID,TS,          ,          ,,
ToolID,TA,ToolID,TS,          ,          ,,
Position,TA,PosID,TS,          ,          ,,
Reason,TA,ID,EP,          ,          ,,

"SELECT Statement"
,,,,,,,
SELECT	TA."FldrID" , TA."OperID" , TA."ONN" , 
	TA."OFF" , EP."ToolChange" , TA."Control" , 
	TA."FtrID" , TS."FtrID"
FROM	"ToolAdj.DB" TA , "ToolAssg.DB" TS , 
	"EndProc.DB" EP
WHERE	( TA."FldrID" = TS."FldrID" )
		AND
	( TA."ToolID" = TS."ToolID" )
		AND
	( TA."Position" = TS."PosID" )
		AND
	( TA."Reason" = EP."ID" )
		AND
	(
	( ( TA."FldrID" = :FldrID ) AND
		( TA."OperID" = :OperID ) AND
		( TS."FtrID" = :FtrID ) )
	)
ORDER BY
	TA."ONN" desc,,,,,,,
