du" , 
	Ip."Zdl" , Ip."Zdi" , Ip."R1" , Ip."R2" , 
	Ip."R3" , Ip."R4" , Ip."R5" , Ip."R6" , Ip."R7" , 
	Ip."R8" , Ip."R9" , Ip."R10" , Ip."R11" , 
