FROM	"Ginsp.DB" Gi , "Insprslt.DB" Ir , 
	"Iinsp.db" Ii , "Ipchart.DB" Ip
WHERE	( Ii."GID" = Gi."ID" )
		AND
	( Ir."InspID" = Ii."ID" )
		AND
	( Ip."RsltID" = Ir."ID" )
		AND
	(
	( ( Ir."FtrID" = :ID ) AND
		( Ii."CharID" = :ID ) AND
		( Gi."InspType" = 9 ) AND
		( Ip."SampleSize" >0 ) )
	)
ORDER BY
	Ir."OSublotID" , Ip."SampleNum",,,,,,,
