FtrID,Tg,ID,ms,          ,          ,,

"SELECT Statement"
,,,,,,,
SELECT	Tg."PosID" , Tg."ToolGroup" , 
	sum( Tg."UnitsPerPart" )
FROM	"ToolAssg.DB" Tg , "msclist.DB" ms
WHERE	( Tg.FtrID = ms.ID )
		AND
	(
	( ( Tg."FldrID" = :FldrID ) AND
		( ms."OperID" = :OperID ) )
	)
GROUP BY
	Tg."PosID" , Tg."ToolGroup",,,,,,,
