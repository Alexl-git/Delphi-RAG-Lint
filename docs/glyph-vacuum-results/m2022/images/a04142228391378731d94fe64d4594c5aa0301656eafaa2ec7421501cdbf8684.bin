"SELECT Statement"
,,,,,,,
SELECT	Fo."WrkOrdrNmbr"
FROM	"FolHeat.DB" Fh , "Folders.DB" Fo
WHERE	( Fh.FolderID = Fo.Fldr_SystID )
		AND
	(
	( Fh."Heat" = :ID )
	)
ORDER BY
	Fo."WrkOrdrNmbr",,,,,,,
