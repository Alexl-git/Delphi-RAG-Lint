# Lint rules deployed next to the binary by the test harness (source of truth is rules/)
third_party/*/rules/

# Local build scratch at repo root (ad-hoc rsvars+msbuild wrappers; `> nul` redirect
# artifact from Git Bash, where `nul` is not a device name). `nul` is a reserved
# Windows device name -- committing it can break `git checkout` for others.
/nul
/build*.bat
/build*.err
scratchpad/

# YADF / tree-sitter test artifacts (user working copies, not tracked)
.yadf-artifacts/

# Auto-Document Phase 3 T3d2 item 2: accumulating per-run test output.
# tests/autotest/results/*.json (~50 files and growing) and
# tests/autotest/logs/ are untracked today -- harmless until `git add -A`
# sweeps them into a commit. Checked: no other tests/ subdirectory
# accumulates output the same way (only tests/autotest does).
tests/autotest/results/*.json
tests/autotest/logs/

# Generated by the ConvRulesEditor build (brcc32 ConvRulesEditorStyles.rc)
src/tools/convrules-editor/ConvRulesEditorStyles.res

# Fatal breadcrumb written by the CLI catch-all (see DRagLint.CLI.Run).
drag-lint-fatal.log

# --- internal working notes: local only, never published ---
docs/INBOX-*
docs/INBOX-Done/*
docs/OPEN-ITEMS.md
docs/RESUME-*
# DESIGN-* is the written output of an owner-gated decision and is referenced
# only from an INBOX note, which is itself local-only. They also quote customer
# source verbatim -- the exception-naming design carries 82 ORM3 message
# strings -- so they belong in this block, not in the published docs set.
docs/DESIGN-*
docs/wiki-featuremap.tsv

# MSBuild regenerates circular-demo's .res on every build even though the .dpr
# has no {$R *.res}. Ignored so a rebuild of the sample project does not leave
# an untracked artefact behind.
circular-demo/*.res
docs/PLAN-*
docs/NEXT-SESSION-PLAN-*
docs/QUESTIONS-*
docs/TRIAGE-*
docs/BACKLOG-*
docs/TODO-URGENT-*
docs/DESIGN-2026-*
docs/FIX-2026-*
docs/IDE-POLISH-*
docs/marathon-*
docs/test-findings-*
docs/Z14SLCT-*
docs/probe-*
docs/superpowers/*
docs/reviews/*
.superpowers/*
stats/*
AGENT_USAGE_NOTES.md
build-output.txt
build_result.txt
clean_rebuild_result.txt
rebuild_result.txt
test_reconcile.txt
lint-report-*.txt
FEATURES.txt
Lint Features report.txt
*stderrcap.txt

# Generated manual (session 27). Built on demand by tools\build-manual.ps1 from
# docs\wiki\*.md. NOT tracked: it is ~1.5 MB of binary per regeneration, and the
# freshness guard requires regenerating on every wiki edit, so tracking it would
# add that much to history each time. Ship it on the GitHub release instead.
docs/drag-lint-manual.docx
docs/drag-lint-manual.pdf

# Old release staging dirs -- retrievable from backups / GitHub releases.
build/release-artifacts*/

# autodoc writes <unit>.pas.bak beside every file it rewrites unless
# --no-backup is passed. 40 of them reached a commit on 2026-08-26 (45,025
# lines) because `git add -A src` swept them in.
*.pas.bak
*.dfm.bak
