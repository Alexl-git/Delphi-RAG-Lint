{
  "id": "large-magic-number",
  "severity": "info",
  "message": "Integer literal -- consider naming the constant",
  "warn_capture": "magic",
  "exclude_if_ancestor": ["declConst", "constInline", "declStringCodePage", "declLabel", "label", "goto", "declArray", "caseLabel", "declEnumValue", "declProp", "exprSubscript"],
  "exclude_if_preceded_by": ["(?:^|[^A-Za-z0-9_])dispid\\s+$"],
  "exclude_if_argument_of": ["EncodeDate", "EncodeTime", "EncodeDateTime", "Reg"]
}
