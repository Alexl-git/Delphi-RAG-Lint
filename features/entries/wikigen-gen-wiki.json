  "status": "shipped",
  "since": "1.56.0-alpha",
  "summary": "Writes one Markdown page per repository table with a section per field: caption, type, kind, descriptions and where the project index shows, edits and uses it",
  "intro": "Read this to produce a browsable wiki of the field repository. repo gen-wiki writes one page per table (or one per field with --per-field) and a second run with no change writes nothing; pages of tables that left the repository are listed as stale, never deleted.",
  "wikiPage": "repo-gen-wiki",
  "surfaces": [
    {
      "type": "cli",
      "verb": "repo",
      "sub": "gen-wiki",
      "example": "drag-lint repo gen-wiki --project <x.dproj> --output <dir> --per-field",
      "usage": "drag-lint repo gen-wiki (--repo <file> | --project <file>) --output <dir> [--per-field] [--table <T,...>] [--db <project db>] [--dry-run] [--json]",
      "flags": [
        {
          "name": "--output",
          "arg": "<dir>"
        },
        {
          "name": "--per-field"
        },
        {
          "name": "--table",
          "arg": "<T,...>"
        },
        {
          "name": "--db",
          "arg": "<project db>"
        },
        {
          "name": "--dry-run"
        },
        {
          "name": "--json"
        }
      ]
    }
  ],
  "audience": "both",
