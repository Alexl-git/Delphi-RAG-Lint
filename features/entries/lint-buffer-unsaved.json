{
  "id": "lint-buffer-unsaved",
  "title": "Lint Buffer (Unsaved)",
  "group": "linting",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "0.1.0-alpha",
  "summary": "Lints the current editor buffer's in-memory content, including unsaved edits, without writing it to disk first",
  "wikiPage": "Lint-Buffer-Unsaved",
  "surfaces": [
    {
      "type": "ide-about",
      "caption": "Lint Buffer (Unsaved)"
    },
    {
      "type": "cli",
      "verb": "lint",
      "usage": "drag-lint lint <path> [--rule <id>] [--disable id1,id2] [--rules-dir <dir>] [--json] [--no-preprocess] [--library-db <lib.sqlite>]",
      "flags": [
        {
          "name": "--rule",
          "arg": "<id>"
        },
        {
          "name": "--disable"
        },
        {
          "name": "--rules-dir",
          "arg": "<dir>"
        },
        {
          "name": "--json"
        },
        {
          "name": "--no-preprocess"
        },
        {
          "name": "--library-db",
          "arg": "<lib.sqlite>"
        },
        {
          "name": "--db",
          "arg": "<index.sqlite>"
        },
        {
          "name": "--project-rules"
        },
        {
          "name": "--stand-in-for",
          "arg": "<realpath>"
        }
      ]
    }
  ],
  "audience": "both"
}
