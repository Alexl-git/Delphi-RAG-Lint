{
  "id": "rename-symbol",
  "title": "Rename Symbol",
  "group": "refactoring",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "0.24.0-alpha",
  "summary": "Renames a symbol across the whole indexed project",
  "wikiPage": "Rename-Symbol",
  "surfaces": [
    {
      "type": "ide-menu",
      "path": "drag-lint > Rename Symbol..."
    },
    {
      "type": "cli",
      "verb": "rename",
      "usage": "drag-lint rename --kind symbol --name <QName> --to <New> [--json|--apply|--no-backup] --db <db> - cross-unit rename",
      "flags": [
        {
          "name": "--kind"
        },
        {
          "name": "--name",
          "arg": "<QName>"
        },
        {
          "name": "--to",
          "arg": "<New>"
        },
        {
          "name": "--json"
        },
        {
          "name": "--apply"
        },
        {
          "name": "--no-backup"
        },
        {
          "name": "--db",
          "arg": "<db>"
        }
      ],
      "helpOrder": 52,
      "help": ["  drag-lint rename --kind symbol --name <QName> --to <New> [--json|--apply|--no-backup] --db <db>   - cross-unit rename", "  drag-lint rename --kind param  --file <F> --line <L> --col <C> --to <New> [--json|--apply|--no-backup]  - routine-local rename (param/var autofix)", "  drag-lint rename --qname <Foo.TBar.Baz> --to <NewName> [--db PATH] [--dry-run] [--no-backup]", "      (--qname and --kind symbol refuse, exit 2, when the old name is used in an indexed .inc file: no {$I} refs until 1.22)"]
    }
  ],
  "audience": "both",
  "requires": ["index"]
}
