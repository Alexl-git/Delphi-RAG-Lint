{
  "id": "feature-registry",
  "title": "Feature registry",
  "group": "maintenance",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "1.22.0-alpha",
  "summary": "The machine-checked master list of every feature, and the generator of the index pages",
  "intro": "Read this when you add or change a drag-lint feature: register it with featuregen add, regenerate the pages with featuregen build --all, and let the registry guard name what is still missing. Needs a repository clone and a built featuregen.exe.",
  "wikiPage": "Feature-Registry",
  "surfaces": [
    {
      "type": "script",
      "path": "tools\\publish-release.ps1",
      "args": "-Version -DryRun"
    },
    {
      "type": "workflow",
      "doc": "docs\\wiki\\Feature-Registry.md"
    }
  ],
  "audience": "both",
  "requires": ["powershell7", "repo-clone"],
  "aliases": ["blast radius", "feature list", "quick help", "registry"],
  "questions": [
    {
      "ask": "How do I register a new feature?",
      "command": "featuregen add --id <id> --title <t> --group <g> --owner <o> --summary <s> --intro <i> --wiki-page <p> --surface <spec>"
    },
    {
      "ask": "How do I regenerate the index pages after editing an entry?",
      "command": "featuregen build --all"
    },
    {
      "ask": "Which featuregen verbs exist?",
      "command": "featuregen --help"
    }
  ],
