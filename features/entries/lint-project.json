  "since": "0.48.0-alpha",
  "summary": "Runs project-scoped structural lint rules against an index -- checks such as god-class, unused-public-symbol",
  "intro": "Read this when you want architecture-level findings that need the whole project, such as god-class, circular-uses, unused-public-symbol or layering-violation, rather than per-file diagnostics. It runs those project-scoped rules against an index.",
  "wikiPage": "lint-project",
  "surfaces": [
    {
      "type": "cli",
      "verb": "lint-project",
      "usage": "drag-lint lint-project --db <file.sqlite> [--rule god-class|unused-public-symbol|interface-reference-cycle|layering-violation|unused-private-member|unused-unit-in-uses|circular-uses|repeated-type-switch|global-only-uses-edge|duplicate-global-decl|uses-global-census|discarded-effect-free-result|query-name-with-effect|assert-with-side-effect] [--layers <f.json>] [--json]",
      "flags": [
        {
          "name": "--db",
          "arg": "<file.sqlite>"
        },
        {
          "name": "--rule"
        },
        {
          "name": "--layers",
          "arg": "<f.json>"
        },
        {
          "name": "--json"
        }
      ],
      "helpOrder": 18,
      "help": ["  drag-lint lint-project --db <file.sqlite> [--rule god-class|unused-public-symbol|interface-reference-cycle|layering-violation|unused-private-member|unused-unit-in-uses|circular-uses|repeated-type-switch|global-only-uses-edge|duplicate-global-decl|uses-global-census|discarded-effect-free-result|query-name-with-effect|assert-with-side-effect] [--layers <f.json>] [--json]"]
    }
  ],
