{
  "id": "lint-project",
  "title": "lint-project",
  "group": "linting",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "0.48.0-alpha",
  "summary": "Runs project-scoped structural lint rules against an index -- checks such as god-class, unused-public-symbol",
  "intro": "Read this when you want architecture-level findings that need the whole project, such as god-class, circular-uses, unused-public-symbol or layering-violation, rather than per-file diagnostics. It runs those project-scoped rules against an index.",
  "wikiPage": "lint-project",
  "surfaces": [
    {
      "type": "cli",
      "verb": "lint-project",
      "usage": "drag-lint lint-project --db <file.sqlite> [--profile <name>] [--rule god-class|unused-public-symbol|interface-reference-cycle|layering-violation|unused-private-member|unused-unit-in-uses|circular-uses|repeated-type-switch|global-only-uses-edge|duplicate-global-decl|uses-global-census|discarded-effect-free-result|query-name-with-effect|assert-with-side-effect|enum-ordinal-persisted|unused-enum-value] [--layers <f.json>] [--json] [--output <f>]",
      "flags": [
        {
          "name": "--db",
          "arg": "<file.sqlite>"
        },
        {
          "name": "--rule"
        },
        {
          "name": "--layers",
          "arg": "<f.json>"
        },
        {
          "name": "--json"
        }
      ],
      "helpOrder": 18,
      "help": ["  drag-lint lint-project --db <file.sqlite> [--profile <name>] [--rule god-class|unused-public-symbol|interface-reference-cycle|layering-violation|unused-private-member|unused-unit-in-uses|circular-uses|repeated-type-switch|global-only-uses-edge|duplicate-global-decl|uses-global-census|discarded-effect-free-result|query-name-with-effect|assert-with-side-effect|enum-ordinal-persisted|unused-enum-value] [--layers <f.json>] [--json] [--output <f>]"]
    },
    {
      "type": "ide-menu",
      "path": "drag-lint > Code Quality > Project Structure Rules (god-class, layering...)...",
      "steps": ["Needs an index of the project", "drag-lint > Code Quality > Project Structure Rules (god-class, layering...)...", "Pick the rule; its project-wide findings are listed"]
    }
  ],
  "audience": "both",
  "requires": ["index"],
  "questions": [
    {
      "ask": "Which classes are too big?",
      "command": "drag-lint lint-project --db <file.sqlite> --rule god-class"
    },
    {
      "ask": "Does my layering hold?",
      "command": "drag-lint lint-project --db <file.sqlite> --rule layering-violation --layers <f.json>"
    }
  ],
