{
  "id": "lint-fix-compile-gate",
  "title": "Lint --fix through the compile gate",
  "group": "refactoring",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "1.47.0-alpha",
  "summary": "lint --fix --apply --project X.dproj --compile-gate writes the fixes only if the project still builds; a fix that breaks the compile is refused and rolled back",
  "intro": "Read this before letting lint --fix write into a project you cannot afford to break. With --compile-gate the project builds before and after the write and any compile error rolls every file back. Opt-in: without the flag nothing builds.",
  "wikiPage": "lint-fix-compile-gate",
  "surfaces": [
    {
      "type": "cli",
      "verb": "lint",
      "example": "drag-lint lint --in <f.pas> --db <db> --fix --apply --project <X.dproj> --compile-gate",
      "usage": "drag-lint lint --in <f.pas> --db <db> --fix --apply --project <X.dproj> --compile-gate [--fix-line <L> --fix-rule <id>] [--no-backup] [--platform <p>] [--rsvars <bat>] [--build-timeout <s>]",
      "flags": [
        {
