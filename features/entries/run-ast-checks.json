      "steps": ["Open the file in the editor", "Choose drag-lint > Run AST Checks", "From a shell: `drag-lint check-ast <file> [--db PATH] [--rule <id>] [--format text|json]`"]
    },
    {
      "type": "cli",
      "verb": "check-ast",
      "usage": "drag-lint check-ast <file> [--db PATH] [--rule <id>] [--format text|json]",
      "flags": [
