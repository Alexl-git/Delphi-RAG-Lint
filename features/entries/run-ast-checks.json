  "audience": "both",
  "questions": [
    {
      "ask": "Does this file have AST-level issues?",
      "command": "drag-lint check-ast <file> --db <db>"
    },
    {
      "ask": "How do I run just one AST rule and get JSON?",
      "command": "drag-lint check-ast <file> --rule <id> --format json"
    }
