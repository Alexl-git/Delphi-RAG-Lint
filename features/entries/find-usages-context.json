{
  "id": "find-usages-context",
  "title": "Find Usages",
  "group": "search-navigation",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "0.33.0-alpha",
  "summary": "Lists references to the symbol represented by a Structure-tree node",
  "intro": "Read this when you are browsing the Structure form and want the usages of a symbol without first opening it in the editor. Right-click the tree node and choose Find Usages; it uses the usages verb behind the scenes.",
  "wikiPage": "Find-Usages-context",
  "surfaces": [
    {
      "type": "ide-context",
      "host": "Structure form",
      "caption": "Find Usages",
      "steps": ["Open the Structure form (drag-lint > Show Structure)", "Right-click the node", "Choose Find Usages"]
    },
    {
      "type": "cli",
      "verb": "usages",
      "usage": "drag-lint usages --name <X> [--width narrow|wide|very-wide] [--db <path>] [--depth N] [--format json|--json]",
      "flags": [
        {
          "name": "--name",
          "arg": "<X>"
        },
        {
          "name": "--width"
        },
        {
          "name": "--db",
          "arg": "<path>"
        },
        {
          "name": "--depth",
          "arg": "N"
        },
        {
          "name": "--format"
        },
        {
          "name": "--json"
        }
      ]
    }
  ],
  "audience": "both",
  "questions": [
    {
      "ask": "Where is the symbol of this Structure-tree node used, without opening it?",
      "command": "drag-lint usages --name <X> --db <db>"
    },
    {
      "ask": "Can I widen the usages listing?",
      "command": "drag-lint usages --name <X> --width wide --db <db>"
    }
  ],
