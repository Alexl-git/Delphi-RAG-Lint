  "since": "1.32.0-alpha",
  "summary": "The registry tool: adds and checks feature entries and generates every doc page from features",
  "intro": "Run featuregen from a repository clone to register a feature (add), regenerate the wiki, README and website pages (build --all), guard the registry (check) and stamp an entry as verified (verify). Developer tool; it is not part of any release package.",
  "wikiPage": "featuregen",
  "surfaces": [
    {
      "type": "exe",
      "name": "featuregen.exe"
    },
    {
      "type": "script",
      "path": "build\\_build_featuregen_local.bat",
      "args": "builds featuregen.exe from this checkout"
    },
    {
      "type": "script",
      "path": "tools\\featuregen-gate.ps1",
      "args": "-Repo -Full"
    },
    {
      "type": "workflow",
      "doc": "docs\\wiki\\featuregen.md"
    }
  ],
  "audience": "human",
  "aliases": ["build-feature-pages", "feature registry tool", "registry generator"],
  "questions": [
    {
      "ask": "How do I regenerate every doc page from the registry?",
      "command": "featuregen build --all"
    },
    {
      "ask": "Does the registry match the code?",
      "command": "featuregen check --level full"
    }
  ],
