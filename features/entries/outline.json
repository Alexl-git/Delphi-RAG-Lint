  "summary": "Prints the file-scoped symbol outline for one Pascal unit",
  "intro": "Read this when you want a unit symbol list outside the IDE, or want to see what feeds the Structure tree. Give it a .pas file and it prints that file symbol outline as text or JSON.",
  "wikiPage": "outline",
  "surfaces": [
    {
      "type": "cli",
      "verb": "outline",
      "usage": "drag-lint outline --in <path.pas> [--db <path>] [--format text|json] [--json] [--kind <k[,k...]>] [--no-locals] [--limit N]",
      "flags": [
        {
          "name": "--in",
          "arg": "<path.pas>"
        },
