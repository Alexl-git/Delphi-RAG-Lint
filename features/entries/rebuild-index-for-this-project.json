{
  "id": "rebuild-index-for-this-project",
  "title": "Rebuild Index for This Project",
  "group": "indexing",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "0.2.0-alpha",
  "summary": "Walks a project's .dproj compile closure and (re)builds its index",
  "intro": "Read this after adding or moving units, or when hover, Find Usages or lint results feel stale. It walks the project .dproj compile closure and rebuilds the index for that project.",
  "wikiPage": "Rebuild-Index-for-This-Project",
  "surfaces": [
    {
      "type": "ide-menu",
      "path": "drag-lint > Index & Maintenance > Rebuild Index for This Project",
      "steps": ["Open the project in RAD Studio", "Choose drag-lint > Index & Maintenance > Rebuild Index for This Project", "Wait for the indexing run to finish; progress shows in the IDE", "From a shell instead: `drag-lint index --project <file.dproj> [--db <file.sqlite>] [--recompile|--rebuild]`"]
    },
    {
      "type": "cli",
      "verb": "index",
      "usage": "drag-lint index --project <file.dproj> [--db <file.sqlite>] [--recompile|--rebuild] [--dry-run] [--wait-library <min>] [--require-library] [--watch [--interval N]]",
      "flags": [
        {
          "name": "--project",
          "arg": "<file.dproj>"
        },
        {
          "name": "--db",
          "arg": "<file.sqlite>"
        },
        {
          "name": "--recompile"
        },
        {
          "name": "--rebuild"
        },
        {
          "name": "--dry-run"
        },
        {
          "name": "--wait-library",
          "arg": "<min>"
        },
        {
          "name": "--require-library"
        },
        {
          "name": "--watch"
        },
        {
          "name": "--interval",
          "arg": "N"
        }
      ]
    }
  ],
  "audience": "both",
  "questions": [
    {
      "ask": "How do I rebuild the index for the project I have open?",
      "command": "drag-lint index --project <file.dproj> --rebuild"
    },
    {
      "ask": "How do I refresh the index after edits without a full rebuild?",
      "command": "drag-lint index --project <file.dproj> --db <file.sqlite>"
    }
  ],
