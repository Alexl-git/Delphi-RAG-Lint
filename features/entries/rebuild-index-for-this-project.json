{
  "id": "rebuild-index-for-this-project",
  "title": "Rebuild Index for This Project",
  "group": "indexing",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "0.1.0-alpha",
  "summary": "Walks a project's .dproj compile closure and (re)builds its index",
  "wikiPage": "Rebuild-Index-for-This-Project",
  "surfaces": [
    {
      "type": "ide-menu",
      "path": "drag-lint > Index & Maintenance > Rebuild Index for This Project"
    },
    {
      "type": "cli",
      "verb": "index",
      "usage": "drag-lint index <path> [--db <file.sqlite>] [--watch [--interval N]] [--library-db <lib.sqlite> ...]",
      "flags": [
        {
          "name": "--db",
          "arg": "<file.sqlite>"
        },
        {
          "name": "--watch"
        },
        {
          "name": "--interval",
          "arg": "N"
        },
        {
          "name": "--library-db",
          "arg": "<lib.sqlite>",
          "summary": "consult another index for calls THIS one cannot resolve."
        },
        {
          "name": "--max-file-kb",
          "arg": "N"
        },
        {
          "name": "--no-use-ignore"
        },
        {
          "name": "--no-sql-ms"
        },
        {
          "name": "--deep"
        },
        {
          "name": "--shallow"
        },
        {
          "name": "--exclude-under"
        },
        {
          "name": "--include-only"
        }
      ]
    }
  ],
  "audience": "both"
}
