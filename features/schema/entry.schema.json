{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "drag-lint feature registry entry",
  "description": "One feature. The order of 'properties' below IS the canonical key order every entry file is written in.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "group", "owner", "status", "summary", "wikiPage", "surfaces", "audience"],
  "properties": {
    "id":           { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "title":        { "type": "string", "minLength": 3, "maxLength": 80 },
    "group":        { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "owner":        { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "status":       { "type": "string", "enum": ["shipped", "experimental", "planned", "deprecated", "internal"] },
    "since":        { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-alpha)?$" },
    "summary":      { "type": "string", "minLength": 20, "maxLength": 160 },
    "intro":        { "type": "string", "minLength": 1, "maxLength": 600 },
    "wikiPage":     { "type": "string", "minLength": 1 },
    "helpContext":  { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "surfaces":     { "type": "array", "items": { "type": "object", "required": ["type"],
                      "properties": { "type": { "type": "string",
                        "enum": ["cli", "ide-menu", "ide-context", "ide-about", "tool-window", "shortcut", "lsp", "mcp", "script", "exe", "workflow"] },
                        "usage": { "type": "string" },
                        "flags": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name"],
                                   "properties": { "name": { "type": "string" }, "arg": { "type": "string" }, "summary": { "type": "string" }, "default": { "type": "string" } } } },
                        "helpOrder": { "type": "integer", "minimum": 1 },
                        "help": { "type": "array", "items": { "type": "string" } },
                        "steps": { "type": "array", "items": { "type": "string" } } } } },
    "audience":     { "type": "string", "enum": ["human", "agent", "both"] },
    "requires":     { "type": "array", "items": { "type": "string",
                      "enum": ["index", "library-index", "sql-index", "graphviz", "powershell7", "repo-clone", "live-ide", "word-com", "firebird", "yadf", "drag-lint-graph", "compiler"] } },
    "aliases":      { "type": "array", "items": { "type": "string", "minLength": 2 } },
    "related":      { "type": "array", "items": { "type": "string" } },
    "examples":     { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind"],
                      "properties": { "kind": { "type": "string", "enum": ["command", "file", "image"] },
                                      "text": { "type": "string" }, "path": { "type": "string" }, "note": { "type": "string" } } } },
    "pitfalls":     { "type": "array", "items": { "type": "string" } },
    "questions":    { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["ask"],
                      "properties": { "ask": { "type": "string" }, "command": { "type": "string" } } } },
    "notes":        { "type": "string", "maxLength": 1000 },
    "access":       { "type": "string", "enum": ["cli-only", "repo-tooling", "standalone-app"] },
    "accessReviewed": { "type": "object", "additionalProperties": false, "required": ["date", "by"],
                      "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "by": { "type": "string", "minLength": 1 } } },
    "supersededBy": { "type": "string" },
    "removedIn":    { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-alpha)?$" },
    "family":       { "type": "string", "enum": ["lint-rules", "chart-questions"] },
    "lastVerified": { "type": "object", "additionalProperties": false, "required": ["date", "by", "build"],
                      "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                                      "by": { "type": "string", "minLength": 1 }, "build": { "type": "string" } } },
    "verified":     { "type": "object", "additionalProperties": false, "required": ["date", "by", "build"],
                      "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "by": { "type": "string", "minLength": 1 },
                                      "build": { "type": "string" }, "surfaceHash": { "type": "string" } } },
    "homeOrder":    { "type": "integer", "minimum": 1 },
    "tests":        { "type": "array", "items": { "type": "string" } }
  }
}
