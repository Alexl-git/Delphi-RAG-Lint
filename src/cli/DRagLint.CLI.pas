      var ClosureList: TArray<string> := nil;
      try
        ScopeDict:= BuildProjectFileScope(AArgs);
        if ScopeDict <> nil then
          for var ScopedFile: string in ScopeDict.Keys do ClosureList:= ClosureList + [ScopedFile];
