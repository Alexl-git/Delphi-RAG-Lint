var
  JArr: TJSONArray ;
  JObj: TJSONObject;
  R   : TReference ;
  Path: string     ;
begin
  if AsJson then
  begin
    JArr:= TJSONArray.Create;
    try
      for R in ARefs do
      begin
        Path:= AStore.GetFilePath(R.FileId);
        JObj:= TJSONObject.Create;
        JObj.AddPair('id', TJSONNumber.Create(R.Id));
