    begin
      TArray.Sort<string>(KnownIds);
      Writeln(Format('ERROR: unknown rule "%s"', [AArgs.Rule]));
      Writeln(Format('known rules (%d): %s', [Length(KnownIds), string.Join(', ', KnownIds)]));
      Exit(2);
    end;
  end;
