unit DRagLint.FieldRepo.ConstMark;

{ drag-lint 1.53 -- lane FR-PRELOAD: the repository mark of a unit generated by `repo gen-const`, and the
  staleness check behind `repo check-const` (spec 2026-11-22-field-repository-v2-design.md section 7).
  The mark is a SHA-256 per generated table over the column layout and the canonical `repo backup` text of that
  table, plus one SHA-256 over all of them. It depends on the repository CONTENT only: never on a file time, on
  DL_META or on a table that was not generated. }

interface

uses
  FireDAC.Comp.Client,
  DRagLint.FieldRepo.Schema;

const
  /// <summary>Name of the constant that carries the whole mark in a generated unit.</summary>
  CONST_MARK_NAME = 'REPO_CONTENT_HASH';

type
  /// <summary>The mark of one generated table.</summary>
  TConstTableMark = record
    /// <summary>Repository table name.</summary>
    Table: string;
    /// <summary>Row count at generation (header information only).</summary>
    Rows: Integer;
    /// <summary>SHA-256 (64 lower-case hex digits) of the table's layout and backup text.</summary>
    Hash: string;
  end;

  /// <summary>What a generated unit file says about itself.</summary>
  TConstUnitMark = record
    /// <summary>The overall hash of the header; '' when the file carries no mark.</summary>
    Overall: string;
    /// <summary>The value of the REPO_CONTENT_HASH constant; '' when absent.</summary>
    ConstValue: string;
    /// <summary>SHA-256 of the form file (data module only); '' for a constant unit.</summary>
    FormHash: string;
    /// <summary>The generated tables in generation order.</summary>
    Tables: TArray<TConstTableMark>;
  end;

  /// <summary>Verdict of CheckConstUnit: current, stale, or the check itself could not be made.</summary>
  TConstCheckState = (ccsCurrent, ccsStale, ccsError);

  /// <summary>Verdict plus one line per reason.</summary>
  TConstCheck = record
    /// <summary>The verdict.</summary>
    State: TConstCheckState;
    /// <summary>Reasons; a changed table is reported as "TABLE: ..." (empty when current).</summary>
    Reasons: TArray<string>;
  end;

/// <summary>Computes the marks of the given tables from an open repository.</summary>
/// <param name="pConn">Open repository connection (read only).</param>
/// <param name="pTables">Tables to mark, as RepoTablesFor returns them.</param>
/// <returns>One mark per table, in the given order.</returns>
/// <exception cref="ERepoError">A table of pTables is not in the repository's backup text.</exception>
/// <remarks>Reads the whole repository once. Deterministic over the content. Not thread-safe over one connection.</remarks>
function ConstTableMarks(pConn: TFDConnection; const pTables: TArray<TRepoTable>): TArray<TConstTableMark>;

/// <summary>The overall hash: SHA-256 over "TABLE=hash" of every mark in order.</summary>
/// <param name="pMarks">Marks in generation order.</param>
/// <returns>64 lower-case hex digits.</returns>
/// <remarks>Pure; thread-safe.</remarks>
function ConstMarkHash(const pMarks: TArray<TConstTableMark>): string;

/// <summary>The header comment lines that carry the mark (read back by ParseConstMark).</summary>
/// <param name="pMarks">Marks in generation order.</param>
/// <param name="pFormHash">FormTextHash of the .dfm text; '' for a constant unit.</param>
/// <returns>CRLF-terminated comment lines.</returns>
/// <remarks>Pure; thread-safe.</remarks>
function ConstMarkHeader(const pMarks: TArray<TConstTableMark>; const pFormHash: string): string;

/// <summary>SHA-256 of a form text with every CR removed, so a line-end conversion by version control is not a change.</summary>
/// <param name="pText">The .dfm text.</param>
/// <returns>64 lower-case hex digits.</returns>
/// <remarks>Pure; thread-safe.</remarks>
function FormTextHash(const pText: string): string;

/// <summary>Reads the mark out of a generated unit's source.</summary>
/// <param name="pSource">The .pas text.</param>
/// <returns>The mark; Overall is '' when the source carries none.</returns>
/// <remarks>Pure; thread-safe. Reads up to the mark constant only, never the data below it.</remarks>
function ParseConstMark(const pSource: string): TConstUnitMark;  // dl:ok unused-public-symbol -- REVIEWED 2026-11-23 FR-PRELOAD: the inverse of ConstMarkHeader, asserted directly by tests/fieldrepo/ConstGenTests.dpr

/// <summary>Compares a generated unit file with the repository.</summary>
/// <param name="pConn">Open repository connection (read only).</param>
/// <param name="pUnitFile">The generated .pas file; for a data module the .dfm beside it is checked too.</param>
/// <returns>ccsCurrent; ccsStale with the changed tables (or the edited / missing form) named; ccsError when the
/// file is missing or carries no mark.</returns>
/// <remarks>Never writes. Not thread-safe over one connection.</remarks>
function CheckConstUnit(pConn: TFDConnection; const pUnitFile: string): TConstCheck;

implementation

uses
  System.SysUtils,
  System.Classes,
  System.IOUtils,
  System.Math,
  System.Hash,
  DRagLint.FieldRepo.TextBackup;

const
  CRLF = #13#10;
  MARK_OVERALL = '// Repository mark: ';
  MARK_FORM = '// Form file: sha256 ';
  MARK_TABLE = '//   ';
  MARK_COLON = ': ';
  MARK_ROWS = ' rows, sha256 ';
  MARK_CONST = CONST_MARK_NAME + ' = ''';
  BACKUP_RECORD = '[';
  BACKUP_END = '#end ';
  FORM_EXT = '.dfm';

{ Lines pFirst..pLast joined by LF, the #DLREPO line and anything else above the first record left out. }
function JoinRecords(pLines: TStrings; pFirst, pLast: Integer): string;
var
  VSb: TStringBuilder;
  VI, VStart: Integer;
begin
  VStart := pFirst;
  while (VStart < pLast) and not pLines[VStart].StartsWith(BACKUP_RECORD) do
    Inc(VStart);
  VSb := TStringBuilder.Create;
  try
    for VI := VStart to pLast do
      VSb.Append(pLines[VI]).Append(#10);
    Result := VSb.ToString;
  finally
    VSb.Free;
  end;
end;

{ The records and the trailer of one table; '' when the backup has no such table. }
function TableSection(pLines: TStrings; const pTable: string): string;
var
  VFirst, VI: Integer;
begin
  Result := '';
  VFirst := 0;
  for VI := 0 to pLines.Count - 1 do
    if pLines[VI].StartsWith(BACKUP_END) then
    begin
      if pLines[VI].StartsWith(BACKUP_END + pTable + ' ') then
        Exit(JoinRecords(pLines, VFirst, VI));
      VFirst := VI + 1;
    end;
end;

{ The column layout: a column added, removed, resized or retyped changes the generated code too. }
function LayoutText(const pTable: TRepoTable): string;
var
  VSb: TStringBuilder;
  VCol: TRepoColumn;
begin
  VSb := TStringBuilder.Create(pTable.Name);
  try
    for VCol in pTable.Columns do
      VSb.AppendFormat(' %s:%d:%d:%d', [VCol.Name, Ord(VCol.Kind), VCol.MaxLen, VCol.PkOrder]);
    Result := VSb.Append(#10).ToString;
  finally
    VSb.Free;
  end;
end;

function ConstTableMarks(pConn: TFDConnection; const pTables: TArray<TRepoTable>): TArray<TConstTableMark>;
var
  VLines: TStringList;
  VI: Integer;
  VText: string;
begin
  VLines := TStringList.Create;
  try
    BackupRepositoryToStrings(pConn, VLines);
    SetLength(Result, Length(pTables));
    for VI := 0 to High(pTables) do
    begin
      VText := TableSection(VLines, pTables[VI].Name);
      if VText = '' then
        raise ERepoError.Create('the repository backup has no table ' + pTables[VI].Name);
      Result[VI].Table := pTables[VI].Name;
      Result[VI].Rows := RepoRowCount(pConn, pTables[VI].Name);
      Result[VI].Hash := THashSHA2.GetHashString(LayoutText(pTables[VI]) + VText);
    end;
  finally
    VLines.Free;
  end;
end;

function ConstMarkHash(const pMarks: TArray<TConstTableMark>): string;
var
  VMark: TConstTableMark;
  VText: string;
begin
  VText := '';
  for VMark in pMarks do
    VText := VText + VMark.Table + '=' + VMark.Hash + #10;
  Result := THashSHA2.GetHashString(VText);
end;

function ConstMarkHeader(const pMarks: TArray<TConstTableMark>; const pFormHash: string): string;
var
  VMark: TConstTableMark;
begin
  Result := MARK_OVERALL + ConstMarkHash(pMarks) + CRLF;
  for VMark in pMarks do
    Result := Result + MARK_TABLE + VMark.Table + MARK_COLON + IntToStr(VMark.Rows) + MARK_ROWS + VMark.Hash + CRLF;
  if pFormHash <> '' then
    Result := Result + MARK_FORM + pFormHash + CRLF;
end;

function FormTextHash(const pText: string): string;
begin
  Result := THashSHA2.GetHashString(pText.Replace(#13, ''));
end;

{ "//   TABLE: n rows, sha256 hash" }
function TryParseTable(const pLine: string; out pMark: TConstTableMark): Boolean;
var
  VColon, VRows: Integer;
begin
  Result := False;
  pMark := Default(TConstTableMark);
  VColon := pLine.IndexOf(MARK_COLON);
  VRows := pLine.IndexOf(MARK_ROWS);
  if (VColon < Length(MARK_TABLE)) or (VRows < VColon) then
    Exit;
  pMark.Table := pLine.Substring(Length(MARK_TABLE), VColon - Length(MARK_TABLE));
  pMark.Rows := StrToIntDef(pLine.Substring(VColon + Length(MARK_COLON), VRows - VColon - Length(MARK_COLON)), 0);
  pMark.Hash := Trim(pLine.Substring(VRows + Length(MARK_ROWS)));
  Result := True;
end;

function ParseConstMark(const pSource: string): TConstUnitMark;
var
  VReader: TStringReader;
  VLine: string;
  VMark: TConstTableMark;
begin
  Result := Default(TConstUnitMark);
  VReader := TStringReader.Create(pSource);
  try
    while VReader.Peek >= 0 do
    begin
      VLine := Trim(VReader.ReadLine);
      if VLine.StartsWith(MARK_OVERALL) then
        Result.Overall := VLine.Substring(Length(MARK_OVERALL))
      else if VLine.StartsWith(MARK_FORM) then
        Result.FormHash := VLine.Substring(Length(MARK_FORM))
      else if VLine.StartsWith(MARK_TABLE) and TryParseTable(VLine, VMark) then
        Result.Tables := Result.Tables + [VMark]
      else if VLine.StartsWith(MARK_CONST) then
      begin
        Result.ConstValue := VLine.Substring(Length(MARK_CONST)).TrimRight([';', '''']);
        Exit;
      end;
    end;
  finally
    VReader.Free;
  end;
end;

procedure AddReason(var pCheck: TConstCheck; pState: TConstCheckState; const pReason: string);
begin
  pCheck.State := pState;
  pCheck.Reasons := pCheck.Reasons + [pReason];
end;

function FindTable(const pAll: TArray<TRepoTable>; const pName: string; out pTable: TRepoTable): Boolean;
var
  VTab: TRepoTable;
begin
  Result := False;
  pTable := Default(TRepoTable);
  for VTab in pAll do
    if SameText(VTab.Name, pName) then
    begin
      pTable := VTab;
      Exit(True);
    end;
end;

procedure CheckTables(pConn: TFDConnection; const pMark: TConstUnitMark; var pCheck: TConstCheck);
var
  VAll, VSelected: TArray<TRepoTable>;
  VTab: TRepoTable;
  VOld, VNow: TArray<TConstTableMark>;
  VMark: TConstTableMark;
  VI: Integer;
begin
  VAll := RepoTablesFor(RepoSchemaVersion(pConn));
  VSelected := nil;
  VOld := nil;
  for VMark in pMark.Tables do
    if FindTable(VAll, VMark.Table, VTab) then
    begin
      VSelected := VSelected + [VTab];
      VOld := VOld + [VMark];
    end
    else
      AddReason(pCheck, ccsStale, VMark.Table + ': the table is not in the repository');
  VNow := ConstTableMarks(pConn, VSelected);
  for VI := 0 to Min(High(VNow), High(VOld)) do
    if VNow[VI].Hash <> VOld[VI].Hash then
      AddReason(pCheck, ccsStale, Format('%s: the repository changed (%d rows generated, %d rows now)',
        [VNow[VI].Table, VOld[VI].Rows, VNow[VI].Rows]));
end;

procedure CheckForm(const pUnitFile: string; const pMark: TConstUnitMark; var pCheck: TConstCheck);
var
  VForm: string;
begin
  if pMark.FormHash = '' then
    Exit;
  VForm := ChangeFileExt(pUnitFile, FORM_EXT);
  if not TFile.Exists(VForm) then
    AddReason(pCheck, ccsStale, ExtractFileName(VForm) + ': the form file is missing')
  else if FormTextHash(TFile.ReadAllText(VForm, TEncoding.ANSI)) <> pMark.FormHash then
    AddReason(pCheck, ccsStale, ExtractFileName(VForm) + ': the form file is not the one generated with this unit');
end;

function CheckConstUnit(pConn: TFDConnection; const pUnitFile: string): TConstCheck;
var
  VMark: TConstUnitMark;
begin
  Result := Default(TConstCheck);
  if not TFile.Exists(pUnitFile) then
  begin
    AddReason(Result, ccsError, 'the unit file does not exist: ' + pUnitFile);
    Exit;
  end;
  VMark := ParseConstMark(TFile.ReadAllText(pUnitFile, TEncoding.ANSI));
  if (VMark.Overall = '') or (Length(VMark.Tables) = 0) then
  begin
    AddReason(Result, ccsError, 'no repository mark in ' + pUnitFile + ' (not written by repo gen-const)');
    Exit;
  end;
  if (VMark.ConstValue <> VMark.Overall) or (ConstMarkHash(VMark.Tables) <> VMark.Overall) then
    AddReason(Result, ccsStale, ExtractFileName(pUnitFile) + ': the marks of the unit disagree (edited or badly merged)');
  CheckTables(pConn, VMark, Result);
  CheckForm(pUnitFile, VMark, Result);
end;

end.
