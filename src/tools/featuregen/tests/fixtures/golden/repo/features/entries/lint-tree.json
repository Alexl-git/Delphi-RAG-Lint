{
  "id": "lint-tree",
  "title": "lint-tree",
  "group": "linting",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "1.11.0-alpha",
  "summary": "Answers one question lint-all cannot: does an interface edit to this unit reach any dependent?",
  "wikiPage": "lint-tree",
  "surfaces": [
    {
      "type": "cli",
      "verb": "lint-tree",
      "usage": "drag-lint lint-tree --unit <B.pas> --db <file.sqlite> [--buffer <buf>] [--project <.dproj>]",
      "flags": [
        {
          "name": "--unit",
          "arg": "<B.pas>"
        },
        {
          "name": "--db",
          "arg": "<file.sqlite>"
        },
        {
          "name": "--buffer",
          "arg": "<buf>"
        },
        {
          "name": "--project",
          "arg": "<.dproj>"
        },
        {
          "name": "--baseline",
          "arg": "<f.json>"
        },
        {
          "name": "--write-baseline",
          "arg": "<f.json>"
        },
        {
          "name": "--platform"
        },
        {
          "name": "--with-rules"
        },
        {
          "name": "--compile"
        },
        {
          "name": "--format"
        }
      ]
    }
  ],
  "audience": "both",
  "pitfalls": ["does an interface edit to `<B.pas>` reach any dependent? Exits 0 whether or not it found anything; 2 means it could NOT run. --baseline pins the OLD side to an edit-episode capture -- without it the OLD side is the live index, which is CLI/manual use only."]
}
