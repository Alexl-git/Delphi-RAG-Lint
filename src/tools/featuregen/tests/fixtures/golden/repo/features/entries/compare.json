{
  "id": "compare",
  "title": "Compare a report with current code",
  "group": "diagrams-charts",
  "owner": "CHARTS",
  "status": "shipped",
  "since": "1.28.0-alpha",
  "summary": "Reruns a saved or pasted report and shows before / delta / after",
  "intro": "Read this when a DocInsight report, a tester sheet or a chart may have gone stale: compare reruns its COMMAND against the current index and diffs the normalised text, a forms CSV by row, or a chart by nodes and edges.",
  "wikiPage": "compare",
  "surfaces": [
    {
      "type": "cli",
      "verb": "compare",
      "example": "drag-lint compare --in U.pas --line 120",
      "usage": "drag-lint compare --old <report.txt|forms.csv|bundle dir> [--command \"<id> -Target T -Project P ...>\"] [--project <P.dproj>]",
      "flags": [
        {
          "name": "--old",
          "arg": "<report.txt|forms.csv|bundle dir>"
        },
        {
          "name": "--command"
        },
        {
          "name": "--project",
          "arg": "<P.dproj>"
        },
        {
          "name": "--new",
          "arg": "<same kind>"
        },
        {
          "name": "--old-db",
          "arg": "<old.sqlite>"
        },
        {
          "name": "--db",
          "arg": "<new.sqlite>"
        },
        {
          "name": "--auto"
        },
        {
          "name": "--save"
        },
        {
          "name": "--snapshot-dir",
          "arg": "<dir>"
        },
        {
          "name": "--format"
        },
        {
          "name": "--output",
          "arg": "<file>"
        },
        {
          "name": "--open"
        }
      ]
    }
  ],
  "audience": "both",
  "requires": ["index"],
  "lastVerified": {
    "date": "2026-10-11",
    "by": "alexanderl",
    "build": "1.26.7-alpha"
  }
}
