{
  "id": "callgraph",
  "title": "callgraph",
  "group": "graphs-reports",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "0.91.0-alpha",
  "summary": "Prints an N-deep resolved call tree for a symbol, in either direction",
  "wikiPage": "callgraph",
  "surfaces": [
    {
      "type": "cli",
      "verb": "callgraph",
      "usage": "drag-lint callgraph --qname <X> [--direction callers|callees] [--depth N] --db PATH [--json] (N-deep resolved call tree; cycle-guarded)",
      "flags": [
        {
          "name": "--qname",
          "arg": "<X>"
        },
        {
          "name": "--direction"
        },
        {
          "name": "--depth",
          "arg": "N"
        },
        {
          "name": "--db",
          "arg": "PATH"
        },
        {
          "name": "--json"
        }
      ]
    }
  ],
  "audience": "both",
  "requires": ["index"]
}
