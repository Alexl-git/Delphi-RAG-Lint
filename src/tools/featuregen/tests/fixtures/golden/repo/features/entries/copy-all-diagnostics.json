{
  "id": "copy-all-diagnostics",
  "title": "Copy All Diagnostics",
  "group": "linting",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "0.1.0-alpha",
  "summary": "Puts every lint finding for the current unit onto the clipboard, starting from the Structure form",
  "wikiPage": "Copy-All-Diagnostics",
  "surfaces": [
    {
      "type": "ide-context",
      "host": "Structure form",
      "caption": "Copy All Diagnostics"
    },
    {
      "type": "cli",
      "verb": "lint",
      "usage": "drag-lint lint <path> [--rule <id>] [--disable id1,id2] [--rules-dir <dir>] [--json] [--no-preprocess] [--library-db <lib.sqlite>]",
      "flags": [
        {
          "name": "--rule",
          "arg": "<id>"
        },
        {
          "name": "--disable"
        },
        {
          "name": "--rules-dir",
          "arg": "<dir>"
        },
        {
          "name": "--json"
        },
        {
          "name": "--no-preprocess"
        },
        {
          "name": "--library-db",
          "arg": "<lib.sqlite>"
        },
        {
          "name": "--db",
          "arg": "<index.sqlite>"
        },
        {
          "name": "--project-rules"
        },
        {
          "name": "--stand-in-for",
          "arg": "<realpath>"
        }
      ]
    }
  ],
  "audience": "both"
}
