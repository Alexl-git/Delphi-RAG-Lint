{
  "id": "multi-project-rename",
  "title": "Rename across every project that compiles a shared unit",
  "group": "linting",
  "owner": "ENGINE",
  "status": "shipped",
  "since": "1.29.0-alpha",
  "summary": "A naming fix on a unit several project indexes own renames it in every owner or in none, after an IDE confirmation listing the projects",
  "intro": "Use it when a naming finding (const-casing, type-name-prefix, ...) sits in a unit that more than one project compiles: the rename is checked and applied in every indexed project, or refused with the reason.",
  "wikiPage": "Multi-Project-Rename",
  "surfaces": [
    {
      "type": "cli",
      "verb": "lint",
      "example": "lint --file <f> --fix --fix-line <L> --fix-rule const-casing --db <db>",
      "usage": "drag-lint lint <path> [--rule <id>] [--disable id1,id2] [--rules-dir <dir>] [--json] [--no-preprocess] [--library-db <lib.sqlite>]",
      "flags": [
        {
          "name": "--rule",
          "arg": "<id>"
        },
        {
          "name": "--disable"
        },
        {
          "name": "--rules-dir",
          "arg": "<dir>"
        },
        {
          "name": "--json"
        },
        {
          "name": "--no-preprocess"
        },
        {
          "name": "--library-db",
          "arg": "<lib.sqlite>"
        },
        {
          "name": "--db",
          "arg": "<index.sqlite>"
        },
        {
          "name": "--project-rules"
        },
        {
          "name": "--stand-in-for",
          "arg": "<realpath>"
        }
      ]
    },
    {
      "type": "ide-context",
      "host": "Structure form",
      "caption": "Fix it"
    },
    {
      "type": "ide-context",
      "host": "Structure form",
      "caption": "Fix all in unit"
    }
  ],
  "audience": "both",
  "related": ["fix-all-in-unit", "fix-it", "rename-symbol"],
  "lastVerified": {
    "date": "2026-10-14",
    "by": "alexanderl",
    "build": "1.31.0-alpha"
  }
}
